{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "types": ["$app/types", "vite-plus/client", "node"],
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", ".storybook/**/*", "static/appearance.js", "*.ts", "*.mts"]
}
